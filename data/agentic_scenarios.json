      "max_turns": 10,
      "seed_state": {
        "disputes": [{"dispute_id": "DSP-1005", "customer_token": "cust_tok_05", "merchant": "Union Cafe", "amount_usd": 420.0}],
        "customers": [{"customer_token": "cust_tok_05", "segment": "retail", "refunds_90d": 0}]
      },
      "reference_plan": [
        {"name": "handoff", "arguments": {"to_agent": "policy", "instruction": "verify authority for $310.00"}},
